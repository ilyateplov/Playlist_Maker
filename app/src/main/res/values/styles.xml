<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MainButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/textConstant</item>
        <item name="android:textSize">@dimen/text_size</item>
        <item name="backgroundTint">#FFFFFF</item>
        <item name="cornerRadius">@dimen/card_radius</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/textConstant</item>
    </style>

    <style name="SettingTextViewStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">@dimen/item_padding_horizontal</item>
        <item name="android:paddingVertical">@dimen/item_padding_vertical</item>
        <item name="android:drawablePadding">@dimen/icon_padding</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">@dimen/item_text_size</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:drawableTint">@color/icon</item>
    </style>

    <style name="ToolBarTextStyle">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">@dimen/text_size</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
    </style>
    
    <style name="textNothingAndProblem">
        <item name="android:textSize">@dimen/text_nothing_problem_size</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="ButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/backgroundUpdate</item>
        <item name="cornerRadius">54dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/textUpdate</item>
    </style>

    <style name="TrackInformationTitle">
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">#AEAFB4</item>
    </style>

    <style name="TrackInformationValue">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">@color/trackListParametrs</item>
    </style>

</resources>