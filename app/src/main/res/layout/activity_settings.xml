<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/whiteBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:title="@string/title_settings"
        app:titleTextAppearance="@style/ToolBarTextStyle"
        app:contentInsetStartWithNavigation="0dp"
        app:titleMarginStart="4dp"
        app:navigationIcon="@drawable/ic_back_arrow_24"
        app:navigationIconTint="@color/arrow"/>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/bDarktheme"
        android:text="@string/item_dark_theme"
        style="@style/SettingTextViewStyle"
        android:layout_gravity="start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/bShareapp"
        android:text="@string/item_share_app"
        style="@style/SettingTextViewStyle"
        app:drawableRightCompat="@drawable/ic_share_24" />

    <TextView
        android:id="@+id/bWritesupport"
        android:text="@string/item_write_support"
        style="@style/SettingTextViewStyle"
        app:drawableRightCompat="@drawable/ic_support_24" />

    <TextView
        android:id="@+id/bUseragreement"
        android:text="@string/item_agreement"
        style="@style/SettingTextViewStyle"
        app:drawableRightCompat="@drawable/ic_agreement_24" />

</LinearLayout>