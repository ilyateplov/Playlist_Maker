<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/whiteBackground">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/title_search"
        app:titleTextAppearance="@style/ToolBarTextStyle"
        app:contentInsetStartWithNavigation="0dp"
        app:titleMarginStart="4dp"
        app:navigationIcon="@drawable/ic_back_arrow_24"
        app:navigationIconTint="@color/arrow"/>

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:paddingHorizontal="12dp"
        android:background="@drawable/background_search"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp">
        <EditText
            android:id="@+id/inputEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/title_search"
            android:maxLines="1"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:textColor="@color/black"
            android:textColorHint="@color/textSearch"
            android:fontFamily="@font/ys_display_regular"
            android:textSize="16sp"
            android:drawableLeft="@drawable/ic_search_16"
            android:drawableTint="@color/textSearch"
            android:drawablePadding="8dp"
            android:background="@null" />
        <ImageView
            android:id="@+id/clearIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_close_16"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/stateContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/nothingFound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="102dp"
            android:visibility="invisible"
            tools:visibility="invisible">
            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"
                android:layout_marginLeft="120dp"
                android:layout_marginRight="120dp"
                android:src="@drawable/ic_nothing_found_120"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nothing_found"
                style="@style/textNothingAndProblem"
                android:textColor="@color/textProblem"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="24dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/communicationProblem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="102dp"
            android:visibility="invisible"
            tools:visibility="invisible">
            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"
                android:layout_marginLeft="120dp"
                android:layout_marginRight="120dp"
                android:src="@drawable/ic_communication_problem_120"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/communication_problem"
                style="@style/textNothingAndProblem"
                android:textColor="@color/textProblem"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="24dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/update"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:text="@string/update"
                style="@style/ButtonStyle" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/trackList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            tools:listitem="@layout/item_track"
            tools:visibility="invisible"/>

        <LinearLayout
            android:id="@+id/searchHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            android:visibility="invisible"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/you_searched"
                style="@style/textNothingAndProblem"
                android:textColor="@color/textProblem"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="18dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible"
                tools:listitem="@layout/item_track"
                tools:visibility="visible"
                tools:itemCount="3"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clear_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:text="@string/clear_history"
                style="@style/ButtonStyle"/>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>