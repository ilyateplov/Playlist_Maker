<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainscreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/blue"
    android:paddingHorizontal="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:text="@string/title_playlistmaker"
        android:layout_marginVertical="16dp"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size"
        android:textStyle="bold"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginVertical="24dp"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:id="@+id/bSearch"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardCornerRadius="@dimen/card_radius">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:drawablePadding="@dimen/icon_padding"
                android:text="@string/button_search"
                android:textColor="@color/text"
                android:textSize="@dimen/text_size"
                android:textStyle="bold"
                app:drawableLeftCompat="@drawable/ic_search" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/bMedialibrary"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginVertical="16dp"
            app:cardCornerRadius="@dimen/card_radius">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:drawablePadding="@dimen/icon_padding"
                android:text="@string/button_medialibrary"
                android:textColor="@color/text"
                android:textSize="@dimen/text_size"
                android:textStyle="bold"
                app:drawableLeftCompat="@drawable/ic_medialibrary" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/bSettings"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardCornerRadius="@dimen/card_radius">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:drawablePadding="@dimen/icon_padding"
                android:text="@string/button_setting"
                android:textColor="@color/text"
                android:textSize="@dimen/text_size"
                android:textStyle="bold"
                app:drawableLeftCompat="@drawable/ic_settings" />
        </androidx.cardview.widget.CardView>



    </LinearLayout>
</LinearLayout>